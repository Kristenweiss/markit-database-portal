# Google Cloud OAuth client (Web application type)
# Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud Console > APIs & Services > Credentials > API key
# Restrict it to the Picker API and your Netlify domain as an HTTP referrer.
GOOGLE_PICKER_API_KEY=

# The folder ID of "MarkIt Database" in Drive.
# Open the folder in Drive and copy the string at the end of the URL.
DRIVE_ROOT_FOLDER_ID=

# Only this Google account is allowed to sign in to the portal.
ALLOWED_EMAIL=hello@kwlegal.co

# Random string used to encrypt the session cookie. Generate with:
# openssl rand -hex 32
SESSION_SECRET=
